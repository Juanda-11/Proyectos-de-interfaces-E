{
  "name": "hydrograph-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run coverage",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "build:desktop": "vite build --mode desktop",
    "desktop:dir": "npm run build:desktop && electron-builder --dir",
    "desktop:win": "npm run build:desktop && electron-builder --win",
    "desktop:linux": "npm run build:desktop && electron-builder --linux",
    "desktop:mac": "npm run build:desktop && electron-builder --mac"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.1"
  },
  "description": "HydroGraph AI: editor de redes de suministro de agua asistido por IA (frontend).",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": {
    "name": "Juanda-11",
    "email": "juanda-11@users.noreply.github.com"
  },
  "homepage": "https://github.com/Juanda-11/Proyectos-de-interfaces-E",
  "build": {
    "appId": "com.hydrographai.desktop",
    "productName": "HydroGraph AI",
    "copyright": "Copyright © 2026 Juanda-11",
    "artifactName": "HydroGraph-AI-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "synopsis": "Editor de redes de agua asistido por IA"
    }
  }
}
